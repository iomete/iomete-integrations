<?xml version="1.0" encoding="utf-8"?>

<connection-fields>
  <field name="server" label="Server" value-type="string" category="endpoint"/>

  <field name="port" label="Port" value-type="string" category="endpoint" default-value="443">
    <validation-rule reg-exp="^([1-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"/>
  </field>

  <field name="v-compute-cluster" label="Compute Cluster" value-type="string" category="endpoint"/>

  <field name="v-namespace" label="Namespace" value-type="string" category="endpoint"/>

  <field name="authentication" label="Authentication" value-type="selection" category="authentication" editable="false" default-value="auth-user-pass">
    <selection-group>
      <option value="auth-user-pass" label="Username and Access Token"/>
    </selection-group>
  </field>

  <field name="username" label="Username" value-type="string" category="authentication"/>

  <field name="password" label="Access Token" value-type="string" category="authentication" secure="true"/>

  <field name="v-query-timeout" label="Query Timeout (seconds)" value-type="string" category="advanced" optional="true" placeholder="No timeout">
    <validation-rule reg-exp="^[1-9][0-9]{0,5}$"/>
  </field>

  <field name="v-connect-timeout" label="Connection Timeout (seconds)" value-type="string" category="advanced" optional="true" placeholder="10">
    <validation-rule reg-exp="^[1-9][0-9]{0,3}$"/>
  </field>

  <field name="v-thread-pool-size" label="Client Thread Pool Size" value-type="string" category="advanced" optional="true" placeholder="1">
    <validation-rule reg-exp="^[1-9][0-9]{0,2}$"/>
  </field>

  <field name="v-disable-cert-verification" label="Disable Certificate Verification" value-type="boolean" category="advanced" default-value="false" optional="true">
    <boolean-options>
      <false-value value="false"/>
      <true-value value="true"/>
    </boolean-options>
  </field>
</connection-fields>
